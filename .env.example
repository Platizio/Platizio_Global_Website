# Copy to .env.local for local development, and set the same values in Vercel.
#
# Everything here is compiled into the browser bundle by Vite and is readable by
# anyone who opens the page. None of it is a secret, and nothing secret may be
# added: the Supabase service role key, the Turnstile secret and the Resend key
# all live in Supabase Edge Function secrets only.
#
# With the two Supabase variables unset, the support form falls back to
# Web3Forms and issues no ticket reference. See src/help/api/support.ts.

VITE_SUPABASE_URL=https://qtjnlkobvnhhgsnyufzv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional until go-live. With this unset the captcha widget is not rendered;
# the server has the matching switch and will record captcha_verified = false.
VITE_TURNSTILE_SITE_KEY=
