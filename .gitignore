# Dependencies — never commit these
node_modules/

# Build output
dist/
dist-ssr/

# Local env files
.env
.env.local
.env.*.local
# .env.production was not covered by the patterns above, so it would have been
# committed. Vercel holds production values; nothing needs it in git.
.env.production
.env.development

# Supabase CLI local state. .temp/pooler-url contains a database connection
# string with the password in it — this must never be committed.
supabase/.temp/
supabase/.branches/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db

# SSR bundle emitted by scripts/prerender.mjs
.ssr
